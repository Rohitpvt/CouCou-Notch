# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Explicit text files with LF
*.ts text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.json text eol=lf
*.md text eol=lf
*.html text eol=lf
*.css text eol=lf
*.rs text eol=lf
*.swift text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.sh text eol=lf

# Windows scripts with CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets (prevent git corruption / line-ending mutation)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg text
*.wav binary
*.mp3 binary
*.exe binary
*.dll binary
*.dylib binary
*.so binary
*.zip binary
*.tar.gz binary
*.pdf binary

# Linguist documentation tagging
docs/** linguist-documentation
design/** linguist-documentation
